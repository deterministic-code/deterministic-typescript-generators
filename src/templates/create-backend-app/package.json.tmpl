    "zod": "^3.23.8"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "@types/express": "^4.17.21",
    "tsx": "^4.17.0",
    "vitest": "^2.1.8",
    "@faker-js/faker": "^9.9.0"
  }
}
